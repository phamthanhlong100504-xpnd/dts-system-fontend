# Next server proxy origin. Do not append /api.
# Copy to .env.local for development; private .env files stay outside Git.
GATEWAY_API_URL=http://localhost:8888

# next.config.ts forwards /api/* and /question-images/* to this Gateway.
# Backend origins, JWT keys, database passwords and MinIO credentials belong to backend configuration.
# Start local frontend with: npm run dev -- --port 3000
# Docker production rewrites use GATEWAY_API_URL supplied at image build time.
