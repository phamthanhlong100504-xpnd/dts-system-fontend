# === Local dev ===
# Base URL của 3 backend service (không kể prefix /api — rewrite tự thêm).
# Giá trị mặc định khi chạy `next dev` trên máy local.
IDENTITY_API_URL=http://localhost:8081
PRACTICE_API_URL=http://localhost:8082
PROGRESS_API_URL=http://localhost:8083

# === Production (VPS) ===
# Không cần set thủ công — deploy workflow (.github/workflows/deploy.yml)
# tự ghi .env trỏ qua docker network dts-network (port internal):
#   IDENTITY_API_URL=http://dts-identity-service:8081
#   PRACTICE_API_URL=http://dts-practice-service:8087
#   PROGRESS_API_URL=http://dts-progress:8083
