# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — chỉ commit bản mẫu .env.example, ignore toàn bộ env local
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CI/CD workflow — pushed manually (requires `workflow` scope on the token)
.github/workflows/deploy.yml

# Ops/verification scripts — may contain credentials
scripts/

# ---------------------------------------------------------------
# Enterprise / non-source files (không liên quan trực tiếp tới source)
# ---------------------------------------------------------------

# AI agent / editor co-pilot config — không commit
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/

# IDE / Editors
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
ehthumbs.db

# Logs & runtime
*.log
logs/

# Caches & build tooling
.turbo/
.cache/
.eslintcache
